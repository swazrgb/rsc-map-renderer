{
  "name": "rsc-world3d-viewer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Standalone WebGL viewer for the OpenRSC 3D world. Renders the engine-baked terrain + scenery mesh and billboarded NPC/player sprites from a static /api/world3d asset tree; entity data is injected (empty in the open-source demo, live in a closed-source host).",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "format": "prettier --write .",
    "check": "npm run check:format && npm run check:lint && npm run check:types",
    "check:format": "prettier --check .",
    "check:lint": "eslint --max-warnings 0 .",
    "check:types": "tsc --noEmit",
    "lint": "eslint --max-warnings 0 ."
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@floating-ui/react": "^0.27.20",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@eslint-react/eslint-plugin": "5.20.0",
    "@eslint/js": "10.0.1",
    "@types/node": "^25.9.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/three": "^0.185.1",
    "@vitejs/plugin-react": "^6.0.2",
    "eslint": "10.11.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.12.0",
    "prettier": "3.9.8",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0",
    "vite": "^8.0.16"
  }
}
